def procesar_pedidos(lista_pedidos):
    total_ingresos = 0
    productos_vendidos = {}
    for pedido in lista_pedidos:
        total_ingresos += pedido["total"]
        for producto in pedido["productos"]:
            if producto in productos_vendidos:
                productos_vendidos[producto] += 1
            else:
                productos_vendidos[producto] = 1  
    producto_mas_vendido = max(productos_vendidos, key=productos_vendidos.get)
    return (total_ingresos, producto_mas_vendido)
if __name__ == "__main__":
    pedidos = [
        {"id": 1, "productos": ["cafe", "medialuna"], "total": 1500},
        {"id": 2, "productos": ["cafe", "tostado"], "total": 2200},
        {"id": 3, "productos": ["medialuna", "jugo"], "total": 1800}
    ]
    ingresos, mas_vendido = procesar_pedidos(pedidos)
    print("--- REPORTE CAFETERIA ---")
    print(f"Total ingresos del dia: ${ingresos}")
    print(f"Producto mas vendido: {mas_vendido}")

